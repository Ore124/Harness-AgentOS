# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# After installing requirements, also install Playwright browsers:
#   pip install -r requirements.txt
#   python -m playwright install chromium

# --- API Configuration ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
HARNESS_MODEL=gpt-4o

# --- Workspace ---
HARNESS_WORKSPACE=./workspace

# --- Harness Tuning (optional) ---
# MAX_HARNESS_ROUNDS=5
# PASS_THRESHOLD=7.0
# COMPRESS_THRESHOLD=80000
# RESET_THRESHOLD=150000
# MAX_AGENT_ITERATIONS=60

# --- Durable runtime (legacy remains the default during migration) ---
# HARNESS_RUNTIME=durable
# HARNESS_DURABLE_PROJECTS=default
# HARNESS_DURABLE_ROLLOUT_PERCENT=10
# HARNESS_DATABASE_URL=postgresql+psycopg://harness:harness@127.0.0.1:5432/harness
# HARNESS_EXECUTION_CAPABILITY=local
# HARNESS_WORKER_CAPABILITIES=local
# HARNESS_WORKER_EXECUTOR=local
# HARNESS_WORKER_HEARTBEAT_SECONDS=15
# HARNESS_WORKER_POLL_SECONDS=1
# HARNESS_RETRY_BACKOFF_SECONDS=5
# HARNESS_GIT_REPOSITORY=/srv/repos/project
# HARNESS_GIT_BASE_REVISION=main
# HARNESS_GIT_TARGET_BRANCH=main
# HARNESS_GIT_WORKTREE_ROOT=/srv/harness-worktrees

# Production workers should use Docker activities and controlled egress.
# HARNESS_EXECUTION_CAPABILITY=docker
# HARNESS_WORKER_CAPABILITIES=docker
# HARNESS_WORKER_EXECUTOR=docker
# HARNESS_AGENT_SANDBOX_IMAGE=harness-runtime:latest
# HARNESS_AGENT_EGRESS_NETWORK=harness-egress
# HARNESS_AGENT_EGRESS_PROXY=http://egress-proxy:3128
# HARNESS_AGENT_NETWORK_HOSTS=api.openai.com

# --- OIDC and project RBAC ---
# HARNESS_AUTH_MODE=oidc
# HARNESS_OIDC_ISSUER=https://identity.example.com/
# HARNESS_OIDC_AUDIENCE=harness-runtime
# HARNESS_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# --- S3-compatible artifact storage ---
# HARNESS_ARTIFACT_STORE=s3
# HARNESS_S3_BUCKET=harness-artifacts
# HARNESS_S3_PREFIX=harness-artifacts
# HARNESS_S3_ENDPOINT_URL=http://127.0.0.1:9000
# HARNESS_S3_PUBLIC_ENDPOINT_URL=https://artifacts.example.com
# AWS_ACCESS_KEY_ID=harness
# AWS_SECRET_ACCESS_KEY=change-me

# --- OpenTelemetry ---
# OTEL_SERVICE_NAME=harness-runtime
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
